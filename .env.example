# ─────────────────────────────────────────────────────────────
# Copy this file to .env for local development, or set these
# as environment variables in your deployment (e.g. Render).
# ─────────────────────────────────────────────────────────────

# API base URL — the single place to change the backend address.
#   Local:      http://127.0.0.1:8000/api
#   Staging:    https://your-staging-server.com/api
#   Production: https://iron-ore-rdms.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# App environment label (informational, used for logging/guards)
VITE_APP_ENV=development

# Set to true to bypass real auth and use mock login data locally
VITE_USE_MOCK_AUTH=false
